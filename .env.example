# =====================================================================
# Home Sweet Home — environment variables
#
# Copy to `.env.local` and fill in. Never commit a real value.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle and are
# therefore PUBLIC. Everything else is server-only and must never be
# referenced from a client component.
# =====================================================================

# --- Application -----------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap,
# robots.txt, and password-reset redirect links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Analytics -------------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave blank in development and preview so real analytics stays clean.
# The site works fully without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Supabase --------------------------------------------------------
# Project URL and anon key. The anon key is safe to expose: every query
# it makes is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security entirely.
# Server-only: used for public lead inserts, audit-log writes, and the
# seed script. Never expose it to the browser and never prefix it with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend or equivalent) ------------------------------------
# Without a key, the app logs intended emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- SMS (Twilio) ----------------------------------------------------
# Without all three, SMS is disabled. Texts are never sent without an
# explicit, recorded SMS consent from the recipient.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Booking ---------------------------------------------------------
# Scheduling link, e.g. https://calendly.com/your-team/property-call
# Without it, the funnel falls back to an in-app appointment request
# that creates a task in the CRM.
CALENDLY_URL=

# --- fal.ai (optional marketing media generation) --------------------
# Entirely optional. Used only to generate generic marketing imagery,
# and only when an admin initiates it. Seller PII, property addresses,
# contracts, and documents are never sent to it.
FAL_KEY=

# --- Address autocomplete (optional) ---------------------------------
# Restrict this key by HTTP referrer in the Google Cloud console — it is
# exposed to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
